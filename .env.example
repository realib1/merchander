# ==============================================================================
# MERCHANDER: Environment Variables Template
# Copy this file to .env.local and adjust variables for your local development setup
# ==============================================================================

# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Public Service URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Paystack API Keys (Platform SaaS Subscriptions & Default Gateway) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Hubtel API Keys (Mobile Money Direct Debit & USSD Prompts) ---
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=2018472

# --- Channel Webhooks (inbound message verification) ---
# Meta app secret: signs the WhatsApp Cloud API payload (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=your_meta_app_secret
# Token you set in the Meta webhook config; echoed back on the GET handshake.
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
# Permanent access token for the WhatsApp Cloud API (used to fetch inbound media).
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# Secret passed to setWebhook; sent back as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_SECRET_TOKEN=your_telegram_secret_token

# --- Default Regional Settings (Ghana) ---
DEFAULT_CURRENCY=GHS
DEFAULT_COUNTRY_CODE=+233
