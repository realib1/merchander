# ==============================================================================
# MERCHANDER: Environment Variables Template
# Copy this file to .env.local for local development.
# For Vercel production deployment, configure these under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Your Supabase project URL and public anon key (Client and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key

# Supabase service role key (SERVER-ONLY: Never expose to browser)
# Used for administrative provisioning, staff security, and privileged webhooks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# ------------------------------------------------------------------------------
# 2. Public Service & Domain Routing (REQUIRED)
# ------------------------------------------------------------------------------
# Primary application URL used for callback links, webhook receivers, and redirects
# Local: http://localhost:3000 | Production: https://app.merchander.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root domain used for merchant store subdomains (e.g. store.merchander.store)
NEXT_PUBLIC_ROOT_DOMAIN=merchander.store

# CNAME target for merchant custom domains
NEXT_PUBLIC_CNAME_TARGET=cname.merchander.store

# Platform support escalation WhatsApp/phone number
NEXT_PUBLIC_SUPPORT_PHONE=+233240000000

# ------------------------------------------------------------------------------
# 3. Paystack API Keys (REQUIRED for SaaS Subscriptions & Card Payments)
# ------------------------------------------------------------------------------
# Test keys begin with sk_test_ / pk_test_; Live keys begin with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. Hubtel API Keys (REQUIRED for Ghana Mobile Money Direct Debits & USSD)
# ------------------------------------------------------------------------------
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=2018472

# ------------------------------------------------------------------------------
# 5. Meta WhatsApp Cloud API (REQUIRED for Omnichannel Messaging)
# ------------------------------------------------------------------------------
# Meta App Secret: Used to verify SHA-256 HMAC signature on incoming webhooks (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret

# Handshake token configured in Meta App Dashboard for webhook verification challenge
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# System user permanent access token for Meta Graph API (outbound messages & media)
WHATSAPP_ACCESS_TOKEN=EAABxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. Telegram Bot Webhook (OPTIONAL)
# ------------------------------------------------------------------------------
# Secret token passed to Telegram setWebhook; validated on incoming updates
TELEGRAM_SECRET_TOKEN=your_telegram_secret_token

# ------------------------------------------------------------------------------
# 7. Regional Settings (Ghana Defaults)
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=GHS
DEFAULT_COUNTRY_CODE=+233

# ------------------------------------------------------------------------------
# 8. Merchander Intelligence Service (Python FastAPI Brain)
# ------------------------------------------------------------------------------
# URL pointing to the deployed Python FastAPI container / worker
# Local: http://127.0.0.1:8000 | Production: https://intelligence.your-domain.com
PYTHON_BRAIN_URL=http://127.0.0.1:8000

# Shared secret key passed in X-API-Key header to authenticate requests to the brain
INTELLIGENCE_SERVICE_API_KEY=dev_secret_key_change_in_production
