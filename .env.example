# ==============================================================================
# MERCHANDER: Environment Variables Template
# Copy this file to .env and adjust variables for your local development setup
# ==============================================================================

# --- Application Environment ---
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key-now
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-jwt-key-now
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- NextAuth Configuration ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-secure-random-nextauth-secret-32-chars

# --- Public Service URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://localhost:8000
WHATSAPP_SERVICE_URL=http://localhost:3001

# --- PostgreSQL Database with Row-Level Security (RLS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merchander_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/merchander_db

# --- Redis & Celery Message Broker ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage Provider ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# --- Default Regional Settings (Ghana) ---
DEFAULT_CURRENCY=GHS
DEFAULT_COUNTRY_CODE=+233
